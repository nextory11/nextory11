# Public browser configuration (never put secrets in VITE_ variables)
VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/your_payment_link
VITE_PAID_CTA_ENABLED=false

# Phase A database (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Phase B Stripe (server-only placeholders)
STRIPE_SECRET_KEY=replace_with_server_only_secret
STRIPE_WEBHOOK_SECRET=replace_with_server_only_webhook_secret
STRIPE_EXPECTED_PRODUCT_ID=prod_replace_me
STRIPE_EXPECTED_PRICE_ID=price_replace_me
STRIPE_EXPECTED_AMOUNT_JPY=980
STRIPE_API_VERSION=replace_with_pinned_api_version

# Phase C AI provider (server-only placeholders)
OPENAI_API_KEY=replace_with_server_only_api_key
AI_REPORT_PROVIDER=openai
AI_REPORT_MODEL=replace_with_owner_approved_model
AI_REPORT_PROMPT_VERSION=ai-juza-system.v1-placeholder
AI_REPORT_TEMPLATE_VERSION=personal-star-report.v1-placeholder

# Phase D delivery and private storage (server-only placeholders)
RESEND_API_KEY=replace_with_server_only_api_key
RESEND_FROM_EMAIL=reports@example.invalid
BLOB_READ_WRITE_TOKEN=replace_with_server_only_blob_token

# Security and operations (server-only placeholders)
UPSTASH_REDIS_REST_URL=https://replace-me.example.invalid
UPSTASH_REDIS_REST_TOKEN=replace_with_server_only_token
REPORT_TOKEN_PEPPER=replace_with_at_least_32_random_characters
INTERNAL_JOB_SECRET=replace_with_at_least_32_random_characters
REPORT_BASE_URL=https://replace-me.example.invalid
REPORT_RETENTION_DAYS=30
REPORT_LINK_TTL_SECONDS=86400
