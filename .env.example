# Public browser configuration. Set the paid CTA to true only after final owner approval.
VITE_PAID_CTA_ENABLED=
# Official 220-question bank. Development defaults to enabled when unset.
# Production must set this explicitly to true. Set false only for the legacy 11-question migration fallback.
VITE_ENABLE_QUESTION_BANK_V1=true
VITE_SUPPORT_EMAIL=

# Database connection strings (server only).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stripe configuration (server only). Use test values until production activation.
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECTED_PRODUCT_ID=
STRIPE_EXPECTED_PRICE_ID=
STRIPE_EXPECTED_AMOUNT_JPY=
STRIPE_API_VERSION=

# Premium Report provider configuration (server only).
OPENAI_API_KEY=
AI_REPORT_PROVIDER=
AI_REPORT_MODEL=
AI_REPORT_PROMPT_VERSION=
AI_REPORT_TEMPLATE_VERSION=
# Server-only, fail-closed V2.3.1 generation gate. Keep unset/false until approved.
PREMIUM_V231_PRODUCTION_ENABLED=
# Temporary, server-only final verification endpoint. Keep disabled/unset by default.
PREMIUM_V231_INTERNAL_VERIFICATION_ENABLED=
PREMIUM_V231_INTERNAL_VERIFICATION_SECRET=

# Optional delivery and private storage (server only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BLOB_READ_WRITE_TOKEN=

# Security and operations (server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REPORT_TOKEN_PEPPER=
INTERNAL_JOB_SECRET=
REPORT_BASE_URL=
REPORT_RETENTION_DAYS=
REPORT_LINK_TTL_SECONDS=
